# Copia este archivo a .env.local y completa con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Ver docs/desarrollo.md.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Avisos en el móvil (D-24, docs/desarrollo.md). Opcional: sin estas tres, la app funciona
# pero no envía avisos. Se generan con `npx web-push generate-vapid-keys`.
# La privada es secreta: solo en Vercel o en .env.local, nunca en el repositorio.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://app-citas-khaki.vercel.app

# Recordatorio de chats parados (D-40, docs/desarrollo.md). Opcional: sin estas dos, no se
# envían recordatorios. Las dos son secretas: solo en Vercel, nunca en el repositorio.
# SUPABASE_SECRET_KEY: Supabase → Project Settings → API Keys → Secret keys.
# CRON_SECRET: cualquier texto largo al azar (por ejemplo, `openssl rand -hex 32`).
SUPABASE_SECRET_KEY=
CRON_SECRET=
